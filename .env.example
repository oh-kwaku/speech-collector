# Reference list of variables for the PRODUCTION stack
# (docker-compose.dokploy.yml). Enter these in Dokploy's per-project
# Environment tab, not a committed .env file — Dokploy injects them the same
# way a .env would for compose variable interpolation.
#
# Local development doesn't need any of this: `docker compose up -d` (the
# plain docker-compose.yml) starts Postgres + MinIO with working defaults,
# and you run the API/frontend natively per the README.

# Public domain the app is reachable at (the Domain you configure in Dokploy
# for the `web`/`api` services).
DOMAIN=recordingapp.example.com

# Postgres
POSTGRES_DB=recordingapp
POSTGRES_USER=recordingapp
POSTGRES_PASSWORD=change-me-to-a-strong-password

# JWT signing (generate with: openssl rand -base64 48)
JWT_SIGNING_KEY=change-me-to-a-long-random-secret
JWT_ISSUER=RecordingApp
JWT_AUDIENCE=RecordingApp

# S3 (any S3-compatible provider: AWS S3, MinIO, DigitalOcean Spaces, Cloudflare
# R2, Backblaze B2, Wasabi, ...)
# - Bundled MinIO (default — docker-compose.dokploy.yml runs a `minio`
#   container and auto-creates the two buckets below on first startup): set
#   S3_SERVICE_URL to the dedicated subdomain you point at the `minio`
#   service (container port 9000) in Dokploy's Domains tab, e.g.
#   https://s3.recordingapp.example.com — it must be a URL the *browser* can
#   reach too, since pre-signed URLs are handed directly to it. Set
#   S3_FORCE_PATH_STYLE=true and S3_ACCESS_KEY/S3_SECRET_KEY to the same
#   values as MINIO_ROOT_USER/MINIO_ROOT_PASSWORD below.
# - AWS S3 instead: set S3_REGION, leave S3_SERVICE_URL blank, remove the
#   minio/minio-init services from docker-compose.dokploy.yml. Credentials
#   can come from S3_ACCESS_KEY/S3_SECRET_KEY or be left blank to use the
#   default AWS credential chain (env vars, shared config, or an instance
#   role).
# - Any other external provider: set S3_SERVICE_URL to its endpoint,
#   S3_FORCE_PATH_STYLE=true, and S3_ACCESS_KEY/S3_SECRET_KEY.
S3_REGION=us-east-1
S3_SERVICE_URL=https://s3.recordingapp.example.com
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=change-me-minio-access-key
S3_SECRET_KEY=change-me-to-a-strong-minio-secret
S3_PHOTOS_BUCKET=photos
S3_AUDIO_BUCKET=audio
S3_PHOTOS_PREFIX=
S3_AUDIO_PREFIX=

# Bundled MinIO (self-hosted S3-compatible object storage). Keep these equal
# to S3_ACCESS_KEY/S3_SECRET_KEY above when using the bundled minio service —
# they're MinIO's own root credentials, and also what the API authenticates
# with. Buckets S3_PHOTOS_BUCKET/S3_AUDIO_BUCKET are created automatically by
# the one-shot `minio-init` service. Ignore these two if using AWS S3 or
# another external provider instead.
MINIO_ROOT_USER=change-me-minio-access-key
MINIO_ROOT_PASSWORD=change-me-to-a-strong-minio-secret

# Gmail SMTP (use a Google Account App Password, not your login password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# First Admin account: since invites can only be sent by an existing Admin, this
# is seeded automatically on first startup (only if no Admin exists yet). Set
# one or the other, then sign in with the normal OTP flow. Safe to leave blank
# on every startup after the first Admin exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
