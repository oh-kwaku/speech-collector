    "RefreshTokenDays": 30
  },
  "S3": {
    "Region": "us-east-1",
    "ServiceUrl": "http://192.168.179.113:9000",
    "ForcePathStyle": true,
    "AccessKey": "admin",
    "SecretKey": "",
    "PhotosBucket": "photos",
    "AudioBucket": "audios",
    "PhotosPrefix": "",
    "AudioPrefix": "",
    "PresignedUrlMinutes": 15
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "REPLACE_WITH_GMAIL_ADDRESS",
